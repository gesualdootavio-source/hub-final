# --- Supabase (produção) ---
# Settings > Database > Connection string > URI (modo Transaction / pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres

# --- Alternativa campos separados (local ou Supabase) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=hdpa
DB_PASSWORD=sua_senha
DB_PORT=5432

# --- Auth ---
JWT_SECRET=123456
AUTH_USER=admin@admin.com
AUTH_PASSWORD=admin123

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Frontend (CORS) ---
FRONTEND_URL=https://seu-dominio.com.br
